DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# URL publik aplikasi. Produksi: https://oplay.id
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Domain platform tanpa protokol. Dipakai untuk membedakan host platform
# (oplay.id) dari custom domain tenant (mis. ylbhsikap.or.id).
PLATFORM_DOMAIN=oplay.id

# Email superadmin (dipisahkan koma). Superadmin dapat mengelola semua tenant.
SUPERADMIN_EMAILS=management@oplay.id

# Buat tenant platform otomatis saat server pertama kali jalan.
PLATFORM_AUTO_SEED=true

# OIDC / PocketID (opsional, untuk login SSO ke admin)
OIDC_URI=https://apps.oplay.id
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
NEXT_PUBLIC_OIDC_CLIENT_ID=

# S3 / Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_PUBLIC_URL=
