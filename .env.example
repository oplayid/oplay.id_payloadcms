# =============================================================================
# OPLAY.ID — VERSI 1.0.0
# Template environment lengkap ( lokal & Coolify ).
# Untuk Coolify, salin isi file ini ke Environment Variables lalu isi <...>.
# Untuk lokal, salin ke .env dan sesuaikan DATABASE_URL / secret.
# =============================================================================

# ─── WAJIB ───────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb://127.0.0.1:27017/oplay?retryWrites=true&w=majority

# Secret acak PANJANG. Bangkitkan: openssl rand -base64 48
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Origin PLATFORM aplikasi. Dibaca SAAT RUNTIME (server-only).
# Mengalahkan NEXT_PUBLIC_SERVER_URL untuk canonical URL, SSO, dan serverURL
# Payload, sehingga image yang sama bisa dipindah host tanpa rebuild.
# Gunakan ROOT domain platform, bukan subdomain tenant (host ini dianggap host
# platform; subdomain tenant bisa 404 bila dipakai sebagai SERVER_URL).
SERVER_URL=http://localhost:3000

# Di-inline SAAT BUILD. Isi sama dengan SERVER_URL.
# Di GitHub Actions, set juga Repository Variable NEXT_PUBLIC_SERVER_URL.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Domain platform tanpa protokol. Contoh produksi: oplay.id
PLATFORM_DOMAIN=localhost


# ─── PLATFORM & CACHE (opsional, disarankan default) ─────────────────────────
PLATFORM_AUTO_SEED=true
PLATFORM_TENANT_SLUG=oplay
# ^ juga dipakai sebagai tenant default untuk user baru yang login via SSO.
PLATFORM_NAME=OPLAY.ID
CONTENT_CACHE=on
APP_VERSION=1.0.0


# ─── PROXY / SECURITY (opsional) ─────────────────────────────────────────────
# Kosong = redirect eksternal ditolak (hanya path internal yang diizinkan).
ALLOWED_REDIRECT_HOSTS=

# www.google.com dan www.openstreetmap.org sudah diizinkan secara default.
ALLOWED_MAP_EMBED_HOSTS=

# Set true HANYA bila proxy tepercaya menimpa x-forwarded-for.
TRUST_X_FORWARDED_FOR=false


# ─── CLOUDFLARE R2 / S3 (opsional, WAJIB untuk upload produksi) ──────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto

# Dibaca SAAT BUILD oleh next.config.ts untuk images.remotePatterns.
# Set Repository Variable GitHub Actions R2_PUBLIC_URL dengan nilai sama.
R2_PUBLIC_URL=


# ─── SSO / POCKET ID (opsional) ──────────────────────────────────────────────
# Kosongkan client id/secret untuk mematikan SSO.
OIDC_URI=https://apps.oplay.id
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
NEXT_PUBLIC_OIDC_CLIENT_ID=

# Jangan set true kecuali sengaja mengizinkan rotasi password akun lokal.
SSO_ADOPT_EXISTING=false
