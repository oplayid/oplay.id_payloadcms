# =============================================================================
# OPLAY.ID — VERSI 1.0.0
# Template environment untuk COOLIFY.
# Salin seluruh isi file ini ke Environment Variables di Coolify, lalu isi nilai
# yang bertanda <...>. Jangan salin file .env lokal ke sini: .env lokal berisi
# secret development dan tidak dipakai oleh Coolify.
# =============================================================================

# ─── WAJIB ───────────────────────────────────────────────────────────────────
# MongoDB produksi (Milik Anda / dedicated cluster disarankan).
DATABASE_URL=mongodb://<user>:<password>@<host>:27017/<database>?authSource=admin&retryWrites=true&w=majority

# Secret acak PANJANG untuk JWT/session Payload. Minimal 32 byte.
# Bangkitkan misalnya: openssl rand -base64 48
PAYLOAD_SECRET=<secret-acak-minimal-32-karakter>

# Origin PLATFORM/publik aplikasi. Dibaca SAAT RUNTIME (server-only).
# Menset ini mengalahkan NEXT_PUBLIC_SERVER_URL untuk canonical URL, SSO, dan
# serverURL Payload. Tanpa ini, image yang sama tidak bisa dipindah host.
# PENTING: isi dengan ROOT domain platform (https://oplay.id), BUKAN subdomain
# tenant. Host SERVER_URL ikut dianggap host platform; jika diisi
# https://umkm.oplay.id, tenant tersebut akan terdeteksi sebagai platform dan
# halamannya bisa 404.
SERVER_URL=https://oplay.id

# Di-inline SAAT BUILD. Isi dengan origin yang SAMA dengan SERVER_URL.
# WAJIB juga diset sebagai Repository Variable GitHub Actions dengan nama
# NEXT_PUBLIC_SERVER_URL agar image CI tidak mengandung localhost.
NEXT_PUBLIC_SERVER_URL=https://oplay.id

# Domain platform tanpa protokol. Dipakai untuk membedakan host platform
# (oplay.id) dari custom domain tenant.
PLATFORM_DOMAIN=oplay.id


# ─── PLATFORM & CACHE (opsional, disarankan dibiarkan default) ───────────────
# Buat tenant platform otomatis saat server pertama kali jalan.
PLATFORM_AUTO_SEED=true

# Slug tenant platform. Ubah hanya jika Anda memang memakai slug lain.
# Juga dipakai sebagai tenant default untuk user baru yang login via SSO.
PLATFORM_TENANT_SLUG=oplay

# Nama tampilan tenant platform.
PLATFORM_NAME=OPLAY.ID

# Cache konten lintas request. Set ke off HANYA untuk debugging invalidation.
CONTENT_CACHE=on

# Versi aplikasi yang dilaporkan /api/health.
APP_VERSION=1.0.0


# ─── PROXY / SECURITY (opsional) ─────────────────────────────────────────────
# Daftar host eksternal yang BOLEH menjadi target Redirect (comma-separated,
# tanpa protokol). Kosong = semua redirect eksternal DITOLAK; path internal
# tetap diizinkan. Contoh: docs.google.com,drive.google.com
ALLOWED_REDIRECT_HOSTS=

# Host tambahan yang diizinkan sebagai src iframe peta (comma-separated).
# www.google.com dan www.openstreetmap.org sudah diizinkan secara default.
ALLOWED_MAP_EMBED_HOSTS=

# Set true HANYA jika reverse proxy Anda MENIMPA (bukan menambah) header
# x-forwarded-for. Jika ragu, biarkan false; x-real-ip/cf-connecting-ip dipakai.
TRUST_X_FORWARDED_FOR=false


# ─── CLOUDFLARE R2 / S3 (opsional, tapi WAJIB untuk upload produksi) ─────────
# Jika salah satu kosong, plugin S3 mati dan upload jatuh ke /app/media yang
# tidak persisten kecuali Anda mount volume.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=
R2_REGION=auto

# Public origin untuk file R2. PENTING: hostname ini juga dibaca SAAT BUILD
# oleh next.config.ts untuk images.remotePatterns. Set Repository Variable
# GitHub Actions R2_PUBLIC_URL dengan nilai yang SAMA, atau next/image bisa
# menghasilkan 500 bila hostname produksi berbeda dari image CI.
R2_PUBLIC_URL=https://storage.assets.oplay.id


# ─── SSO / POCKET ID (opsional) ──────────────────────────────────────────────
# Kosongkan OIDC_CLIENT_ID dan OIDC_CLIENT_SECRET untuk mematikan SSO.
OIDC_URI=https://apps.oplay.id
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Fallback lama untuk client id; isi sama dengan OIDC_CLIENT_ID bila memakai SSO.
NEXT_PUBLIC_OIDC_CLIENT_ID=

# JANGAN set true kecuali Anda sengaja mengizinkan SSO merotasi password akun
# lokal yang sudah ada. Default false = akun lokal tidak pernah ditimpa.
SSO_ADOPT_EXISTING=false


# ─── RUNTIME DOCKER (biasanya diatur Coolify, tidak perlu disalin) ───────────
# PORT=3000
# HOSTNAME=0.0.0.0
# NODE_ENV=production
